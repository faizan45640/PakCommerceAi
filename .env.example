# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
ML_URL=http://localhost:5000

# Database
DATABASE_URL=

# Auth
JWT_SECRET=

# Integrations
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI SDK / LLM Providers (for Business Copilot)
# Provider choices: "google" | "openrouter" | "ollama" (defaults to "google")
AI_PROVIDER=google
AI_MODEL=gemini-1.5-flash

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenRouter (e.g. model: "deepseek/deepseek-chat" or "meta-llama/llama-3.3-70b-instruct")
OPENROUTER_API_KEY=

# Ollama (Local free daemon, e.g. model: "qwen2.5:7b" or "llama3.2:3b")
OLLAMA_BASE_URL=http://localhost:11434/api

