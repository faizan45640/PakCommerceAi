# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
ML_URL=http://localhost:5000

# WhatsApp inbox: POST /api/v1/conversations/mock-inbound fakes a Twilio inbound message.
# On by default when NODE_ENV is development or test; production must set it to true explicitly (demo only).
# ENABLE_MOCK_INBOUND=true

# WhatsApp Cloud API (Meta) spike, T-075. All five required or /api/v1/webhooks/whatsapp returns 404.
# WHATSAPP_ACCESS_TOKEN=            # Graph API bearer token (never commit)
# WHATSAPP_PHONE_NUMBER_ID=         # Phone number ID of the connected number
# WHATSAPP_APP_SECRET=              # Meta app secret; verifies X-Hub-Signature-256
# WHATSAPP_VERIFY_TOKEN=            # string you choose; Meta echoes it on webhook setup
# WHATSAPP_WORKSPACE_ID=            # spike only: workspace that owns the connected number
# WHATSAPP_GRAPH_VERSION=v23.0      # optional Graph API version

# Database
DATABASE_URL=

# Auth
JWT_SECRET=

# Integrations
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI SDK / LLM Providers (for Business Copilot)
# Provider choices: "google" | "deepseek" | "openrouter" | "ollama" (defaults to "google")
# Uncomment and set to override defaults (google / gemini-1.5-flash)
# AI_PROVIDER=deepseek
# AI_MODEL=deepseek-chat

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=

# DeepSeek (OpenAI-compatible; e.g. model: "deepseek-chat" or "deepseek-reasoner")
DEEPSEEK_API_KEY=
# Optional; defaults to https://api.deepseek.com
DEEPSEEK_BASE_URL=

# OpenRouter (e.g. model: "deepseek/deepseek-chat" or "meta-llama/llama-3.3-70b-instruct")
OPENROUTER_API_KEY=

# Ollama (Local free daemon, e.g. model: "qwen2.5:7b" or "llama3.2:3b")
OLLAMA_BASE_URL=http://localhost:11434/api

# Shared secret for the WhatsApp sales agent (apps/ml) calling /api/v1/agent/*.
# The agent sends it as "Authorization: Bearer <token>". Leave unset to switch the
# agent tool surface off entirely (it then answers 404). Use a long random value,
# e.g. `openssl rand -hex 32`, and set the same value in apps/ml.
# AGENT_SERVICE_TOKEN=
