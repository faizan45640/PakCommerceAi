{
  "name": "@pakcommerce/api",
  "version": "0.1.0",
  "private": true,
  "description": "Main backend API — commerce, auth, orchestration",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
