    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@pakcommerce/integrations": "*",
    "@pakcommerce/shared": "*",
    "ai": "^7.0.69",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ollama-ai-provider": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
